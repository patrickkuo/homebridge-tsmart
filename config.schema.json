{
  "pluginAlias": "TSmart",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "description": "Fixed platform label for Homebridge logs (not shown in Apple Home).",
        "type": "string",
        "default": "T-Smart",
        "required": true
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "enabled": {
              "title": "Enable in HomeKit",
              "type": "boolean",
              "default": true
            },
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "ip": {
              "title": "IP Address",
              "type": "string",
              "required": true,
              "format": "ipv4"
            },
            "deviceId": {
              "title": "Device ID",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
